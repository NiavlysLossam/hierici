# ==============================================================================
# Environnement HierIci - Fichier d'exemple (.env.example)
# Copier ce fichier sous le nom .env et adapter les variables selon l'environnement
# ==============================================================================

# Configuration Générale
PROJECT_NAME="HierIci"
ENVIRONMENT="development"
DEFAULT_TERRITORY_SLUG="territoire-pilote"
SECRET_KEY="change_this_to_a_secure_random_key_in_production"

# Base de Données PostgreSQL + PostGIS
POSTGRES_HOST=hierici-db
POSTGRES_PORT=5433
POSTGRES_DB=hierici
POSTGRES_USER=hierici
POSTGRES_PASSWORD=hierici_secret_password

# URL de connexion async pour FastAPI (SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://hierici:hierici_secret_password@hierici-db:5432/hierici

# Stockage Multimédia (local ou s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads

# Configuration S3 (optionnelle, active si STORAGE_DRIVER=s3)
# S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=hierici-media
# S3_REGION=fr-par

# Frontend & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:80", "http://localhost"]

