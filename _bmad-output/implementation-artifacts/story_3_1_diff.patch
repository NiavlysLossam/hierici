@@ -0,0 +1,587 @@
+<script setup lang="ts">
+import { ref, onMounted, onUnmounted, watch } from 'vue'
+import maplibregl from 'maplibre-gl'
+import 'maplibre-gl/dist/maplibre-gl.css'
+import { photoApi } from '@/services/api'
+import type { PhotoGeoJsonFeatureCollection, PhotoGeoJsonFeature } from '@/types/photo'
+
+const props = withDefaults(
+  defineProps<{
+    territoryCenter?: [number, number] // [lng, lat]
+    defaultZoom?: number
+    territoryName?: string
+  }>(),
+  {
+    territoryCenter: () => [5.93, 43.12],
+    defaultZoom: 13,
+    territoryName: 'Territoire',
+  }
+)
+
+const emit = defineEmits<{
+  (e: 'select-photo', photoId: string, feature: PhotoGeoJsonFeature): void
+}>()
+
+const mapContainer = ref<HTMLDivElement | null>(null)
+let map: maplibregl.Map | null = null
+let resizeObserver: ResizeObserver | null = null
+let isMounted = false
+let currentAbortController: AbortController | null = null
+let activePopup: maplibregl.Popup | null = null
+
+const loading = ref(true)
+const error = ref<string | null>(null)
+const photosData = ref<PhotoGeoJsonFeatureCollection | null>(null)
+const totalPublishedCount = ref(0)
+
+// Filtres
+const searchQuery = ref('')
+const filterYearMin = ref<number | undefined>(undefined)
+const filterYearMax = ref<number | undefined>(undefined)
+
+// Style raster OSM libre et sans clé API
+const mapStyle: maplibregl.StyleSpecification = {
+  version: 8,
+  sources: {
+    'osm-tiles': {
+      type: 'raster',
+      tiles: [
+        'https://a.tile.openstreetmap.org/{z}/{x}/{y}.png',
+        'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png',
+        'https://c.tile.openstreetmap.org/{z}/{x}/{y}.png',
+      ],
+      tileSize: 256,
+      attribution:
+        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a> contributeurs',
+      maxzoom: 19,
+    },
+  },
+  layers: [
+    {
+      id: 'osm-tiles-layer',
+      type: 'raster',
+      source: 'osm-tiles',
+      minzoom: 0,
+      maxzoom: 19,
+    },
+  ],
+}
+
+/**
+ * Charge les données GeoJSON depuis l'API publique avec annulation des requêtes précédentes
+ */
+async function loadGeoJsonData() {
+  if (currentAbortController) {
+    currentAbortController.abort()
+  }
+  currentAbortController = new AbortController()
+
+  loading.value = true
+  error.value = null
+
+  try {
+    const data = await photoApi.getPublicPhotos(
+      {
+        search: searchQuery.value.trim() || undefined,
+        year_min: filterYearMin.value,
+        year_max: filterYearMax.value,
+      },
+      currentAbortController.signal
+    )
+
+    if (!isMounted) return
+
+    photosData.value = data
+    totalPublishedCount.value = data.features.length
+
+    if (map && map.isStyleLoaded()) {
+      const source = map.getSource('photos') as maplibregl.GeoJSONSource | undefined
+      if (source) {
+        source.setData(data as any)
+      }
+    }
+  } catch (err: any) {
+    if (err.name === 'AbortError') {
+      // Annulation normale par frappe ultérieure
+      return
+    }
+    console.error('Erreur lors du chargement des données GeoJSON:', err)
+    error.value = err.message || 'Impossible de charger les données photographiques.'
+  } finally {
+    if (isMounted) {
+      loading.value = false
+    }
+  }
+}
+
+/**
+ * Affiche une popup descriptive sur un point individuel sélectionné
+ */
+function showPhotoPopup(feature: PhotoGeoJsonFeature, lngLat: [number, number]) {
+  if (!map) return
+
+  if (activePopup) {
+    activePopup.remove()
+  }
+
+  const p = feature.properties
+  const popupHtml = `
+    <div class="p-2 space-y-2 max-w-[240px] font-sans text-slate-100">
+      ${
+        p.image_thumb_url
+          ? `<img src="${p.image_thumb_url}" alt="${p.title}" class="w-full h-28 object-cover rounded-lg border border-slate-700 shadow-md" />`
+          : ''
+      }
+      <div>
+        <h4 class="font-bold text-xs text-white line-clamp-2 leading-tight">${p.title}</h4>
+        <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-400">
+          ${p.year_taken ? `<span>📅 ${p.year_taken}</span>` : ''}
+          ${p.photographer ? `<span class="truncate">👤 ${p.photographer}</span>` : ''}
+        </div>
+      </div>
+      <button
+        id="hierici-popup-btn-${p.id}"
+        type="button"
+        class="w-full py-1 px-2 mt-1 bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-semibold rounded transition-colors text-center"
+      >
+        Consulter la fiche
+      </button>
+    </div>
+  `
+
+  activePopup = new maplibregl.Popup({
+    closeButton: true,
+    closeOnClick: true,
+    offset: 12,
+    className: 'hierici-map-popup',
+  })
+    .setLngLat(lngLat)
+    .setHTML(popupHtml)
+    .addTo(map)
+
+  // Gestion du clic sur le bouton de consultation dans le DOM de la popup
+  setTimeout(() => {
+    const btn = document.getElementById(`hierici-popup-btn-${p.id}`)
+    if (btn) {
+      btn.onclick = () => {
+        emit('select-photo', p.id, feature)
+      }
+    }
+  }, 50)
+}
+
+/**
+ * Initialise l'instance MapLibre GL et les couches vectorielles de clustering
+ */
+function initMap() {
+  if (!mapContainer.value || !isMounted) return
+
+  map = new maplibregl.Map({
+    container: mapContainer.value,
+    style: mapStyle,
+    center: props.territoryCenter,
+    zoom: props.defaultZoom,
+    maxZoom: 18,
+    minZoom: 4,
+    attributionControl: false,
+  })
+
+  // Contrôles de navigation et attribution
+  map.addControl(new maplibregl.NavigationControl({ showCompass: true }), 'top-right')
+  map.addControl(new maplibregl.AttributionControl({ compact: true }), 'bottom-right')
+
+  map.on('load', () => {
+    if (!map || !isMounted) return
+
+    // 1. Source GeoJSON avec clustering activé côté client
+    map.addSource('photos', {
+      type: 'geojson',
+      data: (photosData.value as any) || { type: 'FeatureCollection', features: [] },
+      cluster: true,
+      clusterMaxZoom: 14, // Au-delà du zoom 14, les points individuels sont toujours affichés
+      clusterRadius: 50,  // Rayon de regroupement en pixels
+    })
+
+    // 2. Couche des cercles de clusters (taille et palette selon densité)
+    map.addLayer({
+      id: 'clusters',
+      type: 'circle',
+      source: 'photos',
+      filter: ['has', 'point_count'],
+      paint: {
+        'circle-color': [
+          'step',
+          ['get', 'point_count'],
+          '#0284c7', // < 10 clichés : sky-600
+          10,
+          '#0d9488', // 10 - 24 : teal-600
+          25,
+          '#d97706', // 25 - 49 : amber-600
+          50,
+          '#e11d48', // >= 50 : rose-600
+        ],
+        'circle-radius': [
+          'step',
+          ['get', 'point_count'],
+          18,
+          10,
+          24,
+          25,
+          30,
+          50,
+          36,
+        ],
+        'circle-stroke-width': 3,
+        'circle-stroke-color': '#ffffff',
+        'circle-opacity': 0.92,
+      },
+    })
+
+    // 3. Couche du décompte textuel à l'intérieur du cercle cluster
+    map.addLayer({
+      id: 'cluster-count',
+      type: 'symbol',
+      source: 'photos',
+      filter: ['has', 'point_count'],
+      layout: {
+        'text-field': '{point_count_abbreviated}',
+        'text-size': 13,
+      },
+      paint: {
+        'text-color': '#ffffff',
+      },
+    })
+
+    // 4. Couche des clichés individuels (points dégroupés)
+    map.addLayer({
+      id: 'unclustered-point',
+      type: 'circle',
+      source: 'photos',
+      filter: ['!', ['has', 'point_count']],
+      paint: {
+        'circle-color': '#0ea5e9',
+        'circle-radius': 9,
+        'circle-stroke-width': 2.5,
+        'circle-stroke-color': '#ffffff',
+        'circle-opacity': 0.95,
+      },
+    })
+
+    // Clic sur un cluster : zoom automatique fluide pour éclater le groupe
+    map.on('click', 'clusters', async (e) => {
+      if (!map) return
+      const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] })
+      const clusterId = features[0]?.properties?.cluster_id
+      if (clusterId === undefined) return
+
+      const source = map.getSource('photos') as maplibregl.GeoJSONSource
+      try {
+        const expansionZoom = await source.getClusterExpansionZoom(clusterId)
+        const coords = (features[0].geometry as any).coordinates.slice()
+
+        // Gestion du cas où les clichés partagent exactement les mêmes coordonnées GPS
+        const currentZoom = map.getZoom()
+        if (expansionZoom <= currentZoom || currentZoom >= 17) {
+          map.easeTo({
+            center: coords,
+            zoom: Math.min(currentZoom + 1, 18),
+            duration: 400,
+          })
+        } else {
+          map.easeTo({
+            center: coords,
+            zoom: Math.min(expansionZoom, 17),
+            duration: 500,
+          })
+        }
+      } catch (err) {
+        console.warn('Impossible de calculer le zoom de cluster:', err)
+      }
+    })
+
+    // Clic sur un cliché individuel dégroupé
+    map.on('click', 'unclustered-point', (e) => {
+      if (!map) return
+      const features = map.queryRenderedFeatures(e.point, { layers: ['unclustered-point'] })
+      const feature = features[0]
+      const featureId = feature?.properties?.id
+      if (!featureId) return
+
+      // Résolution de l'entité complète depuis photosData pour garantir le typage
+      const fullFeature = photosData.value?.features.find((f) => f.properties.id === featureId)
+      if (fullFeature) {
+        const coords = fullFeature.geometry.coordinates
+        showPhotoPopup(fullFeature, coords)
+        emit('select-photo', featureId, fullFeature)
+      }
+    })
+
+    // Changement du curseur au survol
+    map.on('mouseenter', 'clusters', () => {
+      if (map) map.getCanvas().style.cursor = 'pointer'
+    })
+    map.on('mouseleave', 'clusters', () => {
+      if (map) map.getCanvas().style.cursor = ''
+    })
+    map.on('mouseenter', 'unclustered-point', () => {
+      if (map) map.getCanvas().style.cursor = 'pointer'
+    })
+    map.on('mouseleave', 'unclustered-point', () => {
+      if (map) map.getCanvas().style.cursor = ''
+    })
+  })
+
+  // Surveillance des redimensionnements de fenêtre et de conteneur
+  resizeObserver = new ResizeObserver(() => {
+    map?.resize()
+  })
+  resizeObserver.observe(mapContainer.value)
+}
+
+/**
+ * Recentre la vue sur l'emprise du territoire
+ */
+function resetTerritoryView() {
+  if (!map) return
+  map.flyTo({
+    center: props.territoryCenter,
+    zoom: props.defaultZoom,
+    essential: true,
+  })
+}
+
+// Surveillance des changements de filtres avec debounce
+let searchTimer: ReturnType<typeof setTimeout> | null = null
+watch([searchQuery, filterYearMin, filterYearMax], () => {
+  if (searchTimer) clearTimeout(searchTimer)
+  searchTimer = setTimeout(() => {
+    loadGeoJsonData()
+  }, 300)
+})
+
+// Surveillance du changement de territoire actif
+watch(
+  () => props.territoryCenter,
+  (newCenter) => {
+    if (map && newCenter) {
+      map.flyTo({
+        center: newCenter,
+        zoom: props.defaultZoom,
+      })
+      loadGeoJsonData()
+    }
+  }
+)
+
+onMounted(async () => {
+  isMounted = true
+  await loadGeoJsonData()
+  if (isMounted) {
+    initMap()
+  }
+})
+
+onUnmounted(() => {
+  isMounted = false
+
+  if (searchTimer) {
+    clearTimeout(searchTimer)
+    searchTimer = null
+  }
+  if (currentAbortController) {
+    currentAbortController.abort()
+    currentAbortController = null
+  }
+  if (activePopup) {
+    activePopup.remove()
+    activePopup = null
+  }
+  if (resizeObserver) {
+    resizeObserver.disconnect()
+    resizeObserver = null
+  }
+  if (map) {
+    map.remove()
+    map = null
+  }
+})
+
+defineExpose({
+  resize: () => map?.resize(),
+  resetView: resetTerritoryView,
+  refresh: loadGeoJsonData,
+})
+</script>
+
