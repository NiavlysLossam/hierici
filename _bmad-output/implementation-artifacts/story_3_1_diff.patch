+
+      <!-- Badge Décompte & Recentrage -->
+      <div class="flex items-center gap-2 pointer-events-auto bg-slate-900/90 backdrop-blur-md px-3 py-2 rounded-xl border border-slate-700/80 shadow-xl text-xs">
+        <span class="flex items-center gap-1.5 font-semibold text-slate-200">
