+
+function syncUrlState() {
+  const urlParams = new URLSearchParams(window.location.search)
+  const tab = urlParams.get('tab')
+  if (tab === 'recits') {
+    currentTab.value = 'recits'
+  } else if (tab === 'studio') {
+    currentTab.value = 'studio'
+  } else if (tab === 'carte' || tab === 'decouverte') {
+    currentTab.value = 'decouverte'
+  }
+
+  if (urlParams.has('photo') && urlParams.get('photo')) {
+    currentTab.value = 'decouverte'
+  }
+
+  const slug = extractStorymapSlug(window.location)
+  activeStorymapSlug.value = slug
+}
+
+function switchTab(tab: 'decouverte' | 'recits' | 'studio') {
+  currentTab.value = tab
+  const url = new URL(window.location.href)
+  if (tab === 'recits') {
+    url.searchParams.set('tab', 'recits')
+  } else if (tab === 'studio') {
+    url.searchParams.set('tab', 'studio')
+  } else {
+    url.searchParams.delete('tab')
+  }
+  const qs = url.searchParams.toString()
+  const newUrl = `${url.pathname}${qs ? `?${qs}` : ''}${url.hash}`
+  window.history.pushState({}, '', newUrl)
+}
+
+function handleOpenStorymap(slug: string) {
+  activeStorymapSlug.value = slug
+  const url = new URL(window.location.href)
+  url.searchParams.set('storymap', slug)
+  window.history.pushState({}, '', url.toString())
+}
+
+function handleCloseStorymap() {
+  activeStorymapSlug.value = null
+  const newUrl = cleanStorymapUrl(window.location.href)
+  window.history.pushState({}, '', newUrl)
+}
+
+onMounted(async () => {
+  syncUrlState()
+  window.addEventListener('popstate', syncUrlState)
+
+  try {
+    const [healthRes, territoryRes] = await Promise.all([
+      photoApi.getHealth().catch(() => null),
