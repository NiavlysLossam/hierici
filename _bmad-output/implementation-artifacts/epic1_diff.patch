--- /dev/null
+++ b/backend/tests/test_territory.py
@@ -0,0 +1,54 @@
+import uuid
+from datetime import datetime, timezone
+import pytest
+from unittest.mock import patch, AsyncMock, MagicMock
+from fastapi.testclient import TestClient
+from app.main import app
+from app.models.territory import Territory
+from app.core.territory import extract_territory_slug_from_request
+
+client = TestClient(app)
+
+
+def test_extract_territory_slug_header():
+    mock_request = MagicMock()
+    mock_request.headers.get.side_effect = lambda key, default=None: "toulon" if key == "X-Territory-Slug" else ""
+    slug = extract_territory_slug_from_request(mock_request)
+    assert slug == "toulon"
+
+
+def test_extract_territory_slug_subdomain():
+    mock_request = MagicMock()
+    mock_request.headers.get.side_effect = lambda key, default=None: "marseille.hierici.fr:8000" if key == "host" else None
+    slug = extract_territory_slug_from_request(mock_request)
+    assert slug == "marseille"
+
+
+def test_extract_territory_slug_fallback():
+    mock_request = MagicMock()
+    mock_request.headers.get.return_value = None
+    slug = extract_territory_slug_from_request(mock_request)
+    assert slug == "territoire-pilote"
+
+
+@patch("app.core.territory.get_current_territory")
+def test_get_current_territory_endpoint(mock_get_territory):
+    dummy_territory = Territory(
+        id=uuid.uuid4(),
+        slug="territoire-pilote",
+        name="Territoire Pilote",
+        center_lat=43.1242,
+        center_lng=5.9280,
+        default_zoom=13,
+        created_at=datetime.now(timezone.utc),
+    )
+    mock_get_territory.return_value = dummy_territory
+
+    response = client.get("/api/v1/territory/current")
+    assert response.status_code == 200
+    data = response.json()
+    assert data["slug"] == "territoire-pilote"
+    assert data["name"] == "Territoire Pilote"
+    assert data["center_lat"] == 43.1242
+    assert data["center_lng"] == 5.9280
+
diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..7c1b7a0
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,72 @@
+services:
+  # Base de données spatiale PostgreSQL 16 + PostGIS 3.4
+  hierici-db:
+    image: postgis/postgis:16-3.4-alpine
+    container_name: hierici-db
+    restart: unless-stopped
+    environment:
+      POSTGRES_DB: ${POSTGRES_DB:-hierici}
+      POSTGRES_USER: ${POSTGRES_USER:-hierici}
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-hierici_secret_password}
+    ports:
+      - "${POSTGRES_PORT:-5433}:5432"
+    volumes:
+      - pgdata:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-hierici} -d ${POSTGRES_DB:-hierici}"]
+      interval: 5s
+      timeout: 5s
+      retries: 5
+    networks:
+      - hierici-network
+
+  # Backend API FastAPI (Python 3.12)
+  hierici-backend:
+    build:
+      context: .
+      dockerfile: Dockerfile.backend
+    container_name: hierici-backend
+    restart: unless-stopped
+    depends_on:
+      hierici-db:
+        condition: service_healthy
+    env_file:
+      - .env
+    environment:
+      DATABASE_URL: postgresql+asyncpg://${POSTGRES_USER:-hierici}:${POSTGRES_PASSWORD:-hierici_secret_password}@hierici-db:5432/${POSTGRES_DB:-hierici}
+      STORAGE_DRIVER: ${STORAGE_DRIVER:-local}
+      LOCAL_STORAGE_PATH: ${LOCAL_STORAGE_PATH:-/app/uploads}
+      DEFAULT_TERRITORY_SLUG: ${DEFAULT_TERRITORY_SLUG:-territoire-pilote}
+    ports:
+      - "8000:8000"
+    volumes:
+      - ./backend:/app
+      - uploads_data:/app/uploads
+    networks:
+      - hierici-network
+
+  # Frontend Web Vue 3 / Vite
+  hierici-frontend:
+    build:
+      context: .
+      dockerfile: Dockerfile.frontend
+    container_name: hierici-frontend
+    restart: unless-stopped
+    depends_on:
+      - hierici-backend
+    ports:
+      - "5173:80"
+    networks:
+      - hierici-network
+
+volumes:
+  pgdata:
+    name: hierici_pgdata
+  uploads_data:
+    name: hierici_uploads_data
+
+networks:
+  hierici-network:
+    name: hierici-network
+    driver: bridge
+
