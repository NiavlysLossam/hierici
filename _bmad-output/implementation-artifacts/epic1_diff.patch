index 0000000..e1dcd4e
--- /dev/null
+++ b/backend/app/core/security.py
@@ -0,0 +1,56 @@
+from datetime import datetime, timedelta, timezone
+from typing import Any, Union
+from jose import jwt, JWTError
+from passlib.context import CryptContext
+from app.config import settings
+
+# Contexte de hachage de mot de passe (bcrypt)
+pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")
+
+ALGORITHM = "HS256"
+
+
+def verify_password(plain_password: str, hashed_password: str) -> bool:
+    """Vérifie si un mot de passe en clair correspond au hash."""
+    return pwd_context.verify(plain_password, hashed_password)
+
+
+def hash_password(password: str) -> str:
+    """Génère un hash bcrypt sécurisé pour un mot de passe."""
+    return pwd_context.hash(password)
+
+
+def create_access_token(
+    subject: Union[str, Any],
+    email: str,
+    role: str,
+    territory_id: Union[str, None] = None,
+    expires_delta: timedelta | None = None,
+) -> str:
+    """Crée un jeton JWT d'accès signé."""
+    now = datetime.now(timezone.utc)
+    if expires_delta:
+        expire = now + expires_delta
+    else:
+        expire = now + timedelta(minutes=settings.ACCESS_TOKEN_EXPIRE_MINUTES)
+
+    to_encode = {
+        "sub": str(subject),
+        "email": email,
+        "role": role,
+        "territory_id": str(territory_id) if territory_id else None,
+        "iat": now,
+        "exp": expire,
+    }
+    encoded_jwt = jwt.encode(to_encode, settings.SECRET_KEY, algorithm=ALGORITHM)
+    return encoded_jwt
+
+
+def decode_access_token(token: str) -> dict[str, Any] | None:
+    """Décode et valide un jeton JWT d'accès."""
+    try:
+        payload = jwt.decode(token, settings.SECRET_KEY, algorithms=[ALGORITHM])
+        return payload
+    except JWTError:
+        return None
+
diff --git a/backend/app/core/territory.py b/backend/app/core/territory.py
new file mode 100644
index 0000000..b53f560
--- /dev/null
+++ b/backend/app/core/territory.py
@@ -0,0 +1,56 @@
+from fastapi import Request, HTTPException, Depends, status
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+from app.core.database import get_db
+from app.models.territory import Territory
+from app.config import settings
+
+
+def extract_territory_slug_from_request(request: Request) -> str:
+    """Extrait le slug de territoire selon la priorité :
+    1. En-tête HTTP 'X-Territory-Slug'
+    2. Sous-domaine hôte (ex: 'toulon.hierici.fr' -> 'toulon')
+    3. Fallback variable DEFAULT_TERRITORY_SLUG
+    """
+    # 1. En-tête direct
+    header_slug = request.headers.get("X-Territory-Slug")
+    if header_slug and header_slug.strip():
+        return header_slug.strip().lower()
+
+    # 2. Sous-domaine (exclut localhost, 127.0.0.1 ou noms sans sous-domaine)
+    host = request.headers.get("host", "").split(":")[0]
+    parts = host.split(".")
+    if len(parts) >= 3 and parts[0] not in ("www", "api"):
+        return parts[0].lower()
+
+    # 3. Fallback variable d'environnement
+    return settings.DEFAULT_TERRITORY_SLUG.lower()
+
+
+async def get_current_territory(
+    request: Request,
+    db: AsyncSession = Depends(get_db),
+) -> Territory:
+    """Dépendance FastAPI injectant et vérifiant le territoire actif pour les requêtes."""
+    slug = extract_territory_slug_from_request(request)
+
+    query = select(Territory).where(Territory.slug == slug)
+    result = await db.execute(query)
+    territory = result.scalar_one_or_none()
+
+    if not territory:
+        raise HTTPException(
+            status_code=status.HTTP_404_NOT_FOUND,
+            detail={
+                "error": {
+                    "code": "TERRITORY_NOT_FOUND",
+                    "message": f"Le territoire '{slug}' est introuvable ou n'est pas configuré.",
+                    "slug": slug,
+                }
+            },
+        )
+
+    # Injection dans le state de la requête pour réutilisation dans les routes suivantes
+    request.state.territory = territory
+    return territory
+
