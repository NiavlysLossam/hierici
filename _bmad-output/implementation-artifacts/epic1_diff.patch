+<script setup lang="ts">
+import { ref, onMounted } from 'vue'
+
+const apiHealth = ref<{ status: string; database: string } | null>(null)
+const territory = ref<{ slug: string; name: string; center_lat: number; center_lng: number; default_zoom: number } | null>(null)
+const loading = ref(true)
+const error = ref<string | null>(null)
+
+onMounted(async () => {
+  try {
+    const [healthRes, territoryRes] = await Promise.all([
+      fetch('/api/health'),
+      fetch('/api/v1/territory/current')
+    ])
+    if (healthRes.ok) {
+      apiHealth.value = await healthRes.json()
+    }
+    if (territoryRes.ok) {
+      territory.value = await territoryRes.json()
+    }
+  } catch (e: any) {
+    error.value = "Impossible de contacter l'API backend"
+  } finally {
+    loading.value = false
+  }
+})
+</script>
+
+<template>
+  <main class="min-h-screen bg-slate-900 text-slate-100 flex flex-col font-sans">
+    <!-- Header -->
+    <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur px-6 py-4 flex items-center justify-between">
+      <div class="flex items-center space-x-3">
+        <span class="text-2xl">🧭</span>
+        <div>
+          <h1 class="text-xl font-bold tracking-tight text-white">HierIci</h1>
+          <p class="text-xs text-slate-400">Plateforme géohistorique de photos anciennes & storymaps</p>
+        </div>
+      </div>
+      <div class="flex items-center space-x-2 text-xs">
+        <span v-if="territory" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-medium bg-slate-800 text-slate-300 border border-slate-700">
+          📍 {{ territory.name }} ({{ territory.center_lat.toFixed(4) }}, {{ territory.center_lng.toFixed(4) }})
+        </span>
+        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-medium"
+          :class="apiHealth?.database === 'connected' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-amber-950 text-amber-400 border border-amber-800'">
+          <span class="w-1.5 h-1.5 rounded-full" :class="apiHealth?.database === 'connected' ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400'"></span>
+          {{ apiHealth?.database === 'connected' ? 'Système Opérationnel' : 'Connexion API...' }}
+        </span>
+      </div>
+    </header>
+
+    <!-- Hero / Présentation -->
+    <div class="flex-1 max-w-5xl mx-auto px-6 py-12 flex flex-col justify-center">
+      <div class="text-center space-y-6">
+        <div class="inline-block px-3 py-1 rounded-full bg-indigo-950/60 border border-indigo-800 text-indigo-300 text-xs font-semibold uppercase tracking-wider">
+          Projet Open Source — Licence MIT
+        </div>
+        <h2 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
+          Explorer le passé à travers les yeux des photographes d'hier
+        </h2>
+        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
+          Géolocalisation précise avec angle de prise de vue (azimut) et parcours thématiques guidés en scrollytelling.
+        </p>
+
+        <!-- Statut des services -->
+        <div class="pt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto text-left">
+          <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60">
+            <div class="text-xs text-slate-400">Base Spatiale</div>
+            <div class="text-sm font-semibold text-white mt-1">PostgreSQL 16 + PostGIS</div>
+            <div class="text-xs mt-2" :class="apiHealth?.database === 'connected' ? 'text-emerald-400' : 'text-amber-400'">
+              {{ apiHealth?.database === 'connected' ? '● Connectée' : '○ En attente' }}
+            </div>
+          </div>
+          <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60">
