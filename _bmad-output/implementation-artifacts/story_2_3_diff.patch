+  title: '',
+  description: '',
+  photographer: '',
+  year_taken: null,
+  date_exact: '',
+  period_label: '',
+  archive_source: '',
+  archive_ref: '',
+  original_source_url: '',
+  license: 'Domaine Public',
+  latitude: null,
+  longitude: null,
+  bearing: null,
+  field_of_view: 60,
